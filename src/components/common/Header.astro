---
import { Image } from "astro:assets";
import { content } from "../../config/content";
import { siteConfig } from "../../config/site";

const { logo, nav } = content.header;
---

<header class="header" data-header>
  <a class="header__logo" href={logo.href}>
    <Image class="header__mark" src={logo.src} alt="" widths={[96, 144]} sizes="48px" />
    <span class="header__name">{siteConfig.name}</span>
  </a>

  <nav class="header__nav" aria-label="ページ内メニュー">
    {nav.map((item) => (
      <a class="header__link" href={item.href}>{item.label}</a>
    ))}
  </nav>

  <a class="header__tel" href={`tel:${siteConfig.shop.tel.link}`}>
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
      <path fill="currentColor" d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.3 1L6.6 10.8z"/>
    </svg>
    <span>{siteConfig.shop.tel.display}</span>
  </a>

  <button
    class="header__toggle"
    type="button"
    data-menu-toggle
    aria-expanded="false"
    aria-controls="site-menu"
  >
    <span class="sr-only">メニュー</span>
    <span class="header__toggle-line"></span>
    <span class="header__toggle-line"></span>
    <span class="header__toggle-line"></span>
  </button>
</header>

<div class="drawer" id="site-menu" data-menu hidden>
  <nav class="drawer__nav" aria-label="モバイルメニュー">
    {nav.map((item, i) => (
      <a href={item.href} data-menu-link>
        <span class="drawer__num">{String(i + 1).padStart(2, "0")}</span>
        <span>{item.label}</span>
      </a>
    ))}
  </nav>
  <a class="drawer__tel" href={`tel:${siteConfig.shop.tel.link}`} data-menu-link>
    {siteConfig.shop.tel.display}
  </a>
</div>

<style lang="scss">
  @use "../../styles/variables" as *;
  @use "../../styles/mixins" as *;

  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: $header-h;
    padding: 0 1.6rem;
    color: $cream;
    transition: background 0.4s $ease, color 0.4s $ease, box-shadow 0.4s $ease;
  }

  .header.is-scrolled,
  .header.is-open {
    background: rgba(243, 236, 225, 0.94);
    color: $ink;
    box-shadow: 0 1px 0 $line;
    backdrop-filter: blur(14px);
  }

  .header__logo {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    @include hover-opacity;
  }

  .header__mark {
    width: 48px;
    height: 48px;
  }

  .header__name {
    font-family: $font-serif;
    font-size: 1.15rem;
    letter-spacing: 0.28em;
    font-weight: 500;
  }

  .header__nav {
    display: flex;
    gap: 2rem;
    margin-left: auto;
    margin-right: 2rem;
  }

  .header__link {
    font-size: 0.82rem;
    letter-spacing: 0.18em;
    @include hover-underline($gold);
  }

  .header__tel {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 1rem;
    border: 1px solid currentColor;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    transition: background 0.3s $ease, color 0.3s $ease, border-color 0.3s $ease;
  }

  .header__tel:hover {
    background: $vermillion;
    border-color: $vermillion;
    color: $cream;
  }

  .header__toggle {
    display: none;
    width: 2.4rem;
    height: 2.4rem;
    z-index: 50;
  }

  .header__toggle-line {
    display: block;
    width: 1.4rem;
    height: 1px;
    margin: 0.38rem auto;
    background: currentColor;
    transition: transform 0.3s $ease, opacity 0.3s $ease;
  }

  .header.is-open .header__toggle-line:nth-child(2) {
    transform: translateY(7px) rotate(45deg);
  }
  .header.is-open .header__toggle-line:nth-child(3) {
    opacity: 0;
  }
  .header.is-open .header__toggle-line:nth-child(4) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .drawer[hidden] {
    display: none;
  }

  .drawer {
    position: fixed;
    inset: 0;
    z-index: 35;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2.4rem;
    background: $paper;
    color: $ink;
  }

  .drawer__nav {
    display: grid;
    gap: 1.4rem;
    text-align: center;
  }

  .drawer__nav a {
    display: grid;
    gap: 0.3rem;
    font-family: $font-serif;
    font-size: 1.6rem;
    letter-spacing: 0.28em;
  }

  .drawer__num {
    font-family: $font-en;
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    color: $gold;
  }

  .drawer__tel {
    letter-spacing: 0.12em;
    border-bottom: 1px solid $gold;
    padding-bottom: 0.2rem;
  }

  @include tb {
    .header__nav,
    .header__tel {
      display: none;
    }

    .header__toggle {
      display: block;
    }
  }
</style>
