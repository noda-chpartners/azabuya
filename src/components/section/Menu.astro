---
import { Image } from "astro:assets";
import { content, type MenuGroup } from "../../config/content";

const { en, ja, lead, note } = content.menu;
const groups: MenuGroup[] = content.menu.groups;
---

<section class="menu" id="menu">
  <div class="menu__head">
    <div class="section__head reveal">
      <p class="section__en">{en}</p>
      <h2 class="section__ja">{ja}</h2>
      <div class="section__rule"></div>
      <p class="menu__lead">{lead}</p>
      <p class="menu__note">{note}</p>
      <div class="menu__tone">
        <p class="menu__tone-label" id="menu-tone-label">地色</p>
        <div class="menu__tone-switch" role="group" aria-labelledby="menu-tone-label">
          <button class="menu__tone-btn" type="button" data-tone-choice="dark" aria-pressed="true">
            <span class="menu__tone-swatch menu__tone-swatch--dark" aria-hidden="true"></span>
            黒地
          </button>
          <button class="menu__tone-btn" type="button" data-tone-choice="light" aria-pressed="false">
            <span class="menu__tone-swatch menu__tone-swatch--light" aria-hidden="true"></span>
            白地
          </button>
        </div>
      </div>
    </div>
  </div>

  {groups.map((group) => (
    <article class="catalog" id={group.id}>
      <div class="catalog__label">
        <p class="catalog__en">{group.titleEn}</p>
        <h3 class="catalog__title">{group.title}</h3>
      </div>

      <figure class="catalog__figure">
        <Image
          class="catalog__image catalog__image--dark"
          src={group.image}
          alt={group.imageAlt}
          widths={[720, 1080, 1440, 1800]}
          sizes="(min-width: 900px) 72vw, 100vw"
          data-tone-image="dark"
        />
        <Image
          class="catalog__image catalog__image--light"
          src={group.imageLight}
          alt={group.imageAlt}
          widths={[720, 1080]}
          sizes="(min-width: 900px) 72vw, 100vw"
          data-tone-image="light"
          aria-hidden="true"
        />
      </figure>

      <ul class="catalog__list">
        {group.items.map((item) => (
          <li class="catalog__item">
            <div class="catalog__item-main">
              <h4>{item.name}</h4>
              {item.description && <p>{item.description}</p>}
            </div>
            <div class="catalog__prices">
              {item.prices.map((price) => (
                <p>
                  {price.label && <span>{price.label}</span>}
                  <strong>{price.value}</strong>
                  {price.note && <small>{price.note}</small>}
                </p>
              ))}
            </div>
          </li>
        ))}
      </ul>
    </article>
  ))}
</section>

<style lang="scss">
  @use "../../styles/variables" as *;

  .menu {
    --menu-bg: #{$lacquer};
    --menu-fg: #{$cream};
    --menu-muted: rgba(250, 246, 239, 0.68);
    --menu-line: rgba(250, 246, 239, 0.12);
    --menu-accent: #{$gold-light};
    --menu-figure: #000;
    background: var(--menu-bg);
    color: var(--menu-fg);
    transition: background-color 0.4s $ease, color 0.4s $ease;
  }

  :global(html[data-menu-tone="light"]) .menu {
    --menu-bg: #fff;
    --menu-fg: #{$ink};
    --menu-muted: #{$ink-soft};
    --menu-line: rgba(27, 22, 18, 0.12);
    --menu-accent: #{$gold};
    --menu-figure: #fff;
  }

  .menu__head {
    padding: 5.5rem 1.5rem 2.4rem;
  }

  .menu .section__en {
    color: var(--menu-accent);
    transition: color 0.4s $ease;
  }

  .menu .section__rule {
    background: $gold;
  }

  .menu__lead,
  .menu__note {
    max-width: 36rem;
    margin-inline: auto;
    text-align: center;
  }

  .menu__lead {
    margin-top: 1.2rem;
    letter-spacing: 0.1em;
  }

  .menu__note {
    margin-top: 0.8rem;
    color: var(--menu-muted);
    font-size: 0.86rem;
    line-height: 1.9;
    transition: color 0.4s $ease;
  }

  .menu__tone {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.7rem;
  }

  .menu__tone-label {
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    color: var(--menu-accent);
    transition: color 0.4s $ease;
  }

  .menu__tone-switch {
    display: flex;
    gap: 0.45rem;
  }

  .menu__tone-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 6.4rem;
    padding: 0.55rem 1rem;
    border: 1px solid rgba(201, 168, 90, 0.5);
    color: var(--menu-fg);
    letter-spacing: 0.18em;
    font-size: 0.78rem;
    line-height: 1;
    transition: background-color 0.35s $ease, color 0.35s $ease, border-color 0.35s $ease;
  }

  .menu__tone-btn:hover {
    border-color: var(--menu-accent);
  }

  .menu__tone-btn:focus-visible {
    outline: 2px solid var(--menu-accent);
    outline-offset: 3px;
  }

  .menu__tone-btn[aria-pressed="true"] {
    background: var(--menu-fg);
    color: var(--menu-bg);
    border-color: var(--menu-fg);
  }

  .menu__tone-swatch {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgba(27, 22, 18, 0.4);
  }

  .menu__tone-swatch--dark {
    background: #110d0b;
  }

  .menu__tone-swatch--light {
    background: #fff;
  }

  .catalog {
    padding: 2.4rem 0 4.5rem;
    border-top: 1px solid rgba(201, 168, 90, 0.16);
  }

  .catalog__label {
    text-align: center;
    margin-bottom: 1.6rem;
    padding-inline: 1.4rem;
  }

  .catalog__en {
    font-family: $font-en;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--menu-accent);
    font-size: 0.9rem;
    transition: color 0.4s $ease;
  }

  .catalog__title {
    margin-top: 0.35rem;
    font-family: $font-serif;
    font-size: $fs-xl;
    letter-spacing: 0.28em;
    font-weight: 500;
  }

  .catalog__figure {
    display: grid;
    max-width: 920px;
    margin: 0 auto;
    background: var(--menu-figure);
    transition: background-color 0.4s $ease;
  }

  .catalog__image {
    grid-area: 1 / 1;
    width: 100%;
    height: auto;
    align-self: start;
    object-fit: contain;
  }

  .catalog__image--light {
    opacity: 0;
  }

  :global(html[data-menu-tone="light"]) .catalog__image--dark {
    opacity: 0;
  }

  :global(html[data-menu-tone="light"]) .catalog__image--light {
    opacity: 1;
  }

  .catalog__list {
    max-width: 720px;
    margin: 1.8rem auto 0;
    padding-inline: 1.4rem;
  }

  .catalog__item {
    display: grid;
    gap: 0.6rem;
    padding: 1.05rem 0;
    border-bottom: 1px solid var(--menu-line);
  }

  .catalog__item h4 {
    font-family: $font-serif;
    letter-spacing: 0.1em;
    font-size: 1.05rem;
  }

  .catalog__item p {
    margin-top: 0.3rem;
    color: var(--menu-muted);
    font-size: 0.86rem;
    transition: color 0.4s $ease;
  }

  .catalog__prices {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
  }

  .catalog__prices p {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    margin: 0;
    color: var(--menu-fg);
    font-size: 1rem;
    transition: color 0.4s $ease;
  }

  .catalog__prices span,
  .catalog__prices small {
    color: var(--menu-accent);
    transition: color 0.4s $ease;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .catalog__prices strong {
    font-family: $font-en;
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  @media (min-width: 720px) {
    .catalog__item {
      grid-template-columns: 1fr auto;
      align-items: start;
      gap: 1rem 2rem;
    }

    .catalog__prices {
      justify-content: flex-end;
    }
  }

  @media (min-width: 900px) {
    .menu__head {
      padding-top: 6.5rem;
    }

    .catalog {
      padding: 3rem 0 5.5rem;
    }

    .catalog__figure {
      max-width: 1040px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu,
    .menu .section__en,
    .menu__note,
    .menu__tone-label,
    .menu__tone-btn,
    .catalog__en,
    .catalog__figure,
    .catalog__item p,
    .catalog__prices p,
    .catalog__prices span,
    .catalog__prices small {
      transition: none;
    }
  }
</style>
