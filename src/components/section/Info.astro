---
import { siteConfig } from "../../config/site";

const { shop } = siteConfig;

const rows = [
  { label: "店名", value: siteConfig.name },
  { label: "住所", value: shop.address, href: shop.mapUrl },
  { label: "アクセス", value: shop.access },
  { label: "電話", value: shop.tel.display, href: `tel:${shop.tel.link}` },
  { label: "ランチ", value: `${shop.hoursLunch} ／ ${shop.hoursNote}` },
  { label: "ディナー", value: `${shop.hoursDinner} ／ ${shop.hoursNote}` },
  { label: "定休日", value: shop.closed },
  { label: "席数", value: shop.seats },
];
---

<section class="section info" id="info">
  <div class="container">
    <div class="section__head reveal">
      <p class="section__en">Information</p>
      <h2 class="section__ja">店舗情報</h2>
      <div class="section__rule"></div>
    </div>

    <dl class="info__list">
      {rows.map((row) => (
        <div class="info__row reveal">
          <dt>{row.label}</dt>
          <dd>
            {row.href ? (
              <a
                href={row.href}
                target={row.href.startsWith("http") ? "_blank" : undefined}
                rel={row.href.startsWith("http") ? "noopener noreferrer" : undefined}
              >
                {row.value}
              </a>
            ) : (
              row.value
            )}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style lang="scss">
  @use "../../styles/variables" as *;
  @use "../../styles/mixins" as *;

  .info {
    background: $cream;
  }

  .info__list {
    max-width: 720px;
    margin: 0 auto;
  }

  .info__row {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1rem;
    padding: 1.05rem 0;
    border-bottom: 1px solid $line;
  }

  .info__row dt {
    font-family: $font-serif;
    letter-spacing: 0.16em;
    font-weight: 500;
    color: $vermillion;
  }

  .info__row dd a {
    @include hover-underline($gold);
    display: inline;
  }

  @include tb {
    .info__row {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }
</style>
