---
import { Image } from "astro:assets";
import { content } from "../../config/content";

const { image, imageAlt, eyebrow, title, lead } = content.hero;
---

<section class="hero" id="top">
  <Image
    class="hero__image"
    src={image}
    alt={imageAlt}
    widths={[720, 1280, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero__veil"></div>

  <div class="hero__content">
    <p class="hero__eyebrow">{eyebrow}</p>
    <h1 class="hero__title">{title}</h1>
    <p class="hero__lead">{lead}</p>
    <a class="hero__cta" href="#menu">お品書きを見る</a>
  </div>
</section>

<style lang="scss">
  @use "../../styles/variables" as *;
  @use "../../styles/mixins" as *;

  .hero {
    position: relative;
    min-height: 100svh;
    height: 100svh;
    display: grid;
    place-items: end center;
    overflow: hidden;
    background: $lacquer;
    color: $cream;
  }

  .hero__image,
  .hero__veil {
    position: absolute;
    inset: 0;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .hero__veil {
    background: linear-gradient(
      180deg,
      rgba(17, 13, 11, 0.52) 0%,
      rgba(17, 13, 11, 0.08) 32%,
      rgba(17, 13, 11, 0.12) 48%,
      rgba(17, 13, 11, 0.82) 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    text-align: center;
    padding: 0 1.4rem 4.2rem;
  }

  .hero__eyebrow {
    font-family: $font-serif;
    letter-spacing: 0.42em;
    font-size: 0.9rem;
  }

  .hero__title {
    margin-top: 0.7rem;
    font-family: $font-serif;
    font-weight: 600;
    font-size: clamp(3rem, 9vw, 5.6rem);
    letter-spacing: 0.28em;
    line-height: 1.05;
    text-indent: 0.28em;
  }

  .hero__lead {
    margin-top: 1rem;
    font-family: $font-serif;
    letter-spacing: 0.12em;
    font-size: $fs-md;
  }

  .hero__cta {
    margin-top: 1.6rem;
    padding: 0.85rem 1.8rem;
    border: 1px solid $gold;
    letter-spacing: 0.2em;
    font-size: 0.82rem;
    transition: background 0.3s $ease, color 0.3s $ease;
  }

  .hero__cta:hover {
    background: $gold;
    color: $lacquer;
  }
</style>
