---
import { siteConfig } from "../../config/site";

const { shop, name } = siteConfig;
---

<section class="section access" id="access">
  <div class="container--wide">
    <div class="section__head reveal">
      <p class="section__en">Access</p>
      <h2 class="section__ja">アクセス</h2>
      <div class="section__rule"></div>
    </div>

    <div class="access__body">
      <div class="access__meta reveal">
        <address class="access__address">{shop.address}</address>
        <p class="access__walk">{shop.access}</p>
        <p class="access__note">ご来店の際は、不定休のため事前にお電話ください。</p>
      </div>
      <div class="access__map reveal">
        <iframe
          class="access__iframe"
          src={shop.map}
          title={`${name}への地図。${shop.address}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
        <a
          class="access__map-link"
          href={shop.mapUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Googleマップで開く
        </a>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  @use "../../styles/variables" as *;
  @use "../../styles/mixins" as *;

  .access {
    background: $paper;
  }

  .access__body {
    display: grid;
    gap: 1.8rem;
  }

  .access__meta {
    text-align: center;
  }

  .access__address {
    font-family: $font-serif;
    letter-spacing: 0.1em;
    font-size: $fs-md;
  }

  .access__walk {
    margin-top: 0.5rem;
    color: $vermillion;
    letter-spacing: 0.12em;
  }

  .access__note {
    margin-top: 0.8rem;
    color: $ink-soft;
    font-size: 0.86rem;
  }

  .access__iframe {
    width: 100%;
    height: 22rem;
    filter: grayscale(0.25) contrast(1.05);
  }

  .access__map-link {
    display: inline-block;
    margin-top: 1rem;
    letter-spacing: 0.12em;
    font-size: 0.86rem;
    border-bottom: 1px solid $gold;
    @include hover-opacity;
  }

  @media (min-width: 900px) {
    .access__iframe {
      height: 26rem;
    }
  }
</style>
